# 個人資料與最早的命令列工具：只留在本機
legacy/

# 聲音、音檔、設定一律放 VOICE_STUDIO_HOME（~/Library/Application Support/VoiceStudio），這裡保險起見再擋一次。
# 資料夾和設定檔只擋根目錄的（開頭的 / ）：測試的樣本裡有同名的 settings.json，不能一起擋掉
*.wav
*.m4a
*.mp3
# 例外：官網的試聽（site/make-samples.py 用聲音描述與內建配音員產生，沒有真人的聲音）
!/site/public/audio/*.m4a
/voices/
/out/
/settings.json
/pronounce.txt

# Python
.venv/
venv/
__pycache__/
*.pyc

# Swift 與 app 的建置產物
.build/
.swiftpm/
build/
dist/
mac/Resources/VoiceStudio.icns

# 官網的建置產物
site/dist/

.DS_Store

